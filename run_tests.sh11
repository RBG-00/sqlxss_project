#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Config
TARGET_URL_DEFAULT="http://127.0.0.1:8080"
JUICE_PORT=3000
TEST_SERVER_LOG="/tmp/test_server.log"
STARTED_TEST_SERVER=0
WAIT_SECONDS=30
SLEEP_INTERVAL=1

# If caller exported JUICE=1 then target Juice Shop on port 3000
if [ "${JUICE:-0}" = "1" ]; then
  TARGET_URL="http://127.0.0.1:${JUICE_PORT}"
else
  TARGET_URL="${TARGET_URL_DEFAULT}"
fi

echo "Target URL: $TARGET_URL"

# Function: wait for a URL to return any HTTP response code within timeout
wait_for_url() {
  local url=$1
  local timeout_s=$2
  local interval=$3
  local elapsed=0
  while [ $elapsed -lt $timeout_s ]; do
    # silent, just get code if reachable
    code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 3 "$url" || true)
    if [ -n "$code" ] && [ "$code" != "000" ]; then
      echo "OK: $url returned HTTP $code"
      return 0
    fi
    sleep "$interval"
    elapsed=$((elapsed + interval))
  done
  return 1
}

# If test_server.py exists and JUICE not requested, start it
if [ "${JUICE:-0}" != "1" ] && [ -f "${SCRIPT_DIR}/test_server.py" ]; then
  echo "Starting local test_server (background) and writing log to ${TEST_SERVER_LOG}..."
  # kill any previous test_server started by us (best-effort)
  pkill -f test_server.py || true
  # start server in background, capture logs
  (cd "$SCRIPT_DIR" && python3 test_server.py > "${TEST_SERVER_LOG}" 2>&1 &)
  STARTED_TEST_SERVER=1
fi

# Wait for base URL root to become reachable
echo "Waiting for server to become reachable (max ${WAIT_SECONDS}s)..."
if wait_for_url "${TARGET_URL}/" ${WAIT_SECONDS} ${SLEEP_INTERVAL}; then
  echo "Server is up."
else
  echo "ERROR: server did not become reachable at ${TARGET_URL} within ${WAIT_SECONDS}s."
  if [ ${STARTED_TEST_SERVER} -eq 1 ]; then
    echo "---- recent test_server log (last 200 lines) ----"
    tail -n 200 "${TEST_SERVER_LOG}" || true
  fi
  echo "Exiting."
  # cleanup if started
  if [ ${STARTED_TEST_SERVER} -eq 1 ]; then
    pkill -f test_server.py || true
  fi
  exit 1
fi

# Quick baseline checks for the endpoints scanner expects
echo
echo "Running baseline checks for expected endpoints..."
ENDPOINTS=(
  "/vuln/xss?q=test"
  "/vuln/sql?q=test"
  "/rest/user/login"
)
for ep in "${ENDPOINTS[@]}"; do
  url="${TARGET_URL}${ep}"
  echo -n "Checking $url ... "
  code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 5 "$url" || true)
  if [ -n "$code" ] && [ "$code" != "000" ]; then
    echo "HTTP $code"
  else
    echo "no response (or timed out)"
  fi
done

echo
# Run your scanner. The project may accept a base-url flag; try common options.
# 1) try scanner.py with a --base-url flag
if [ -f "${SCRIPT_DIR}/scanner.py" ]; then
  echo "Attempting to run scanner.py with --base-url..."
  if python3 "${SCRIPT_DIR}/scanner.py" --help 2>&1 | grep -qi "base"; then
    python3 "${SCRIPT_DIR}/scanner.py" --base-url "${TARGET_URL}"
  else
    # fallback: try passing URL as first argument
    python3 "${SCRIPT_DIR}/scanner.py" "${TARGET_URL}"
  fi
else
  echo "No scanner.py found in ${SCRIPT_DIR}. If you have another runner, edit this script to call it."
fi

# If your project has a run_tests.py or similar, also attempt to run it
if [ -f "${SCRIPT_DIR}/run_tests.py" ]; then
  echo "Also running run_tests.py (if present)..."
  python3 "${SCRIPT_DIR}/run_tests.py" --base-url "${TARGET_URL}" || true
fi

# Parse/collect report if exists
if [ -f "${SCRIPT_DIR}/report.json" ]; then
  echo "Found report.json — summarizing:"
  jq -r '. | {findings:.findings,summary:.summary}' "${SCRIPT_DIR}/report.json" 2>/dev/null || head -n 50 "${SCRIPT_DIR}/report.json"
fi

# cleanup
if [ ${STARTED_TEST_SERVER} -eq 1 ]; then
  echo "Stopping test_server..."
  pkill -f test_server.py || true
  sleep 1
fi

echo "Done."
